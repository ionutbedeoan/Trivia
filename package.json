{
  "name": "provocarea-scripturilor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "tsx server/index.ts",
    "server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:backup": "tsx server/backup.ts",
    "content:build": "node scripts/build-content.mjs",
    "content:export": "node scripts/export-questions.mjs",
    "format": "prettier --write src server shared tests scripts vite.config.ts playwright.config.ts tsconfig*.json package.json",
    "format:check": "prettier --check src server shared tests scripts vite.config.ts playwright.config.ts tsconfig*.json package.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
